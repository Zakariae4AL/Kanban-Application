# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# --- Security ---
# Long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- Database ---
# "sqljs" = zero-install SQLite file (great for local development)
# "postgres" = PostgreSQL (recommended for production, used by docker compose)
DB_TYPE=sqljs
DB_SQLITE_PATH=data/kanban.sqlite
# Only used when DB_TYPE=postgres
DATABASE_URL=postgres://kanban:kanban@localhost:5432/kanban
